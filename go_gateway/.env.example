# ── Go WebSocket Gateway — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values before starting the gateway.
# The Go service reads these directly from the OS environment (no .env auto-load).
# When using Docker Compose, set these under the service's `environment` key.

# ── Redis ─────────────────────────────────────────────────────────────────────
# Full Redis connection URL including password (if set).
# Docker Compose: redis://:${REDIS_PASSWORD}@redis:6379
# Local dev:      redis://localhost:6379
# Required — the gateway fails fast if this is missing.
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret used to verify signed JWT tokens from Boda Riders.
# Must match the JWT_SECRET used by Laravel to issue rider tokens.
# Generate with: openssl rand -hex 32
# Required — the gateway fails fast if this is missing.
JWT_SECRET=change_me_to_a_strong_secret

# ── Laravel API ───────────────────────────────────────────────────────────────
# Base URL the gateway uses to validate tokens against Laravel (if needed).
# Docker Compose: http://laravel:8000
# Local dev:      http://localhost:8000
# Required — the gateway fails fast if this is missing.
LARAVEL_URL=http://localhost:8000

# ── HTTP Server ───────────────────────────────────────────────────────────────
# Port the gateway listens on for WebSocket (/ws/rider) and health (/health).
# Default: 8002
PORT=8002
