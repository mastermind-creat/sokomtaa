APP_NAME="Soko Mtaa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
# Switch from MySQL to PostgreSQL for PostGIS spatial support.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sokomtaa
DB_USERNAME=sokomtaa
DB_PASSWORD=

# ── Redis (GEO, Pub/Sub, Cache, Sessions) ────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set a strong password in production. Must match REDIS_PASSWORD in docker-compose.
REDIS_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Polyglot Inter-Service Authentication ────────────────────────────────────
# Shared secret used between Laravel ↔ FastAPI.
# Must be identical in both services. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── FastAPI AI Service ────────────────────────────────────────────────────────
# URL where Laravel reaches FastAPI. Use Docker service name in compose.
FASTAPI_URL=http://127.0.0.1:8001
# Token sent as X-Internal-Token header. Defaults to INTERNAL_API_TOKEN if blank.
FASTAPI_INTERNAL_TOKEN=

# ── JWT (Go Gateway) ─────────────────────────────────────────────────────────
# Secret used to sign rider JWT tokens. Must match JWT_SECRET in Go Gateway.
JWT_SECRET=

# ── M-Pesa Daraja API ────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://api.sokomtaa.co.ke/api/payments/mpesa/callback
MPESA_ENV=sandbox

# ── Africa's Talking (SMS) ───────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID="SOKOMTAA"

# ── TalkSasa (alternative SMS) ───────────────────────────────────────────────
TALKSASA_API_KEY=
TALKSASA_SENDER_ID="SOKOMTAA"
TALKSASA_BASE_URL=

# ── Cloudinary (media storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sanctum ──────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,sokomtaa.vercel.app

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@sokomtaa.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
