# ── FastAPI AI Service — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in the values before starting the service.
# All variables are prefixed with FASTAPI_ (see app/config.py).

# ── Authentication ────────────────────────────────────────────────────────────
# Shared secret that Laravel sends as the X-Internal-Token header.
# Must be identical to INTERNAL_API_TOKEN / FASTAPI_INTERNAL_TOKEN in Laravel .env.
# Generate with: openssl rand -hex 32
FASTAPI_INTERNAL_TOKEN=change_me_to_a_strong_secret

# ── Redis ─────────────────────────────────────────────────────────────────────
# Full Redis connection URL including password (if set).
# Docker Compose: redis://:${REDIS_PASSWORD}@redis:6379
# Local dev:      redis://localhost:6379
FASTAPI_REDIS_URL=redis://localhost:6379

# ── Laravel API ───────────────────────────────────────────────────────────────
# Base URL that FastAPI uses to call the Laravel internal endpoints
# (e.g. POST /internal/ai/match-traders).
# Docker Compose: http://laravel:8000
# Local dev:      http://localhost:8000
FASTAPI_LARAVEL_URL=http://localhost:8000

# ── Runtime environment ───────────────────────────────────────────────────────
# Set to "production" to suppress debug output and enable PII redaction in logs.
# Values: "development" | "production"
FASTAPI_ENV=development
